rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{deviceId} {
      allow read, write: if true;

      // 하위 컬렉션(일별 기록 days 등) 전체 허용
      match /{document=**} {
        allow read, write: if true;
      }
    }
    match /admin/{document} {
      allow read, write: if true;
    }
  }
}
